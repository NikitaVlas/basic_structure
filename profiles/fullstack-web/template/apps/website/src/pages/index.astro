---
const title = "{{PROJECT_NAME}}";
---
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>{title}</title><meta name="description" content="{{PROJECT_DESCRIPTION}}" /></head><body><main><p>Public website</p><h1>{title}</h1><p>{{PROJECT_DESCRIPTION}}</p></main></body></html>
<style>body{margin:0;background:#10131a;color:#f4f2ec;font-family:Inter,system-ui,sans-serif}main{max-width:72rem;margin:auto;padding:8rem 2rem}p:first-child{text-transform:uppercase;letter-spacing:.14em;color:#a9b1c4}h1{font-size:clamp(4rem,10vw,9rem);letter-spacing:-.07em;margin:.1em 0}</style>
