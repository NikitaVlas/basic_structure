{
  "name": "{{PROJECT_NAME}}",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=22.12" },
  "overrides": {
    "esbuild": "^0.28.1",
    "sharp": "^0.35.0"
  },
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "docs:check": "node scripts/check-docs.mjs --mode project",
    "security:audit": "npm audit --audit-level=high",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "harness:gate": "basic-structure gate check --project . --json",
    "verify": "npm run docs:check && npm run security:audit && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": { "@basic-structure/cli": "0.1.0" }
}
