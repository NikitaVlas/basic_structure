{
  "$schema": "../../schemas/extension-manifest.schema.json",
  "schemaVersion": 2,
  "kind": "adapter",
  "id": "github-security",
  "version": "1.0.0",
  "starter": ">=0.1.0 <1.0.0",
  "capabilities": ["supply-chain-security","vulnerability-scanning"],
  "tags": ["github","security","automation"],
  "maturity": "stable",
  "name": "GitHub security gates",
  "description": "CodeQL, dependency review, repository secret scanning, container vulnerability scanning, SBOM artifacts, Dependabot, and local posture verification.",
  "files": "template",
  "requires": { "adapter:github-ci": "^1.0.0", "adapter:docker-production": "^1.0.0" },
  "conflicts": [],
  "packageDependencies": {
    "package.json": {
      "scripts": { "security:posture": "node scripts/security-posture.mjs" }
    }
  }
}
