NODE_ENV=production
PORT=3000
APP_ORIGIN=https://app.example.com
PUBLIC_APP_URL=https://app.example.com
DATABASE_URL=postgresql://app:REPLACE_DATABASE_PASSWORD@postgres:5432/app
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=REPLACE_DATABASE_PASSWORD
RATE_LIMIT_BACKEND=valkey
RATE_LIMIT_KEY_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
VALKEY_PASSWORD=REPLACE_VALKEY_PASSWORD
VALKEY_URL=redis://:REPLACE_VALKEY_PASSWORD@valkey:6379
SESSION_DURATION_DAYS=7
IP_HASH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
EMAIL_TRANSPORT=smtp
EMAIL_FROM=no-reply@example.com
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=REPLACE_SMTP_USER
EMAIL_SMTP_PASSWORD=REPLACE_SMTP_PASSWORD
EMAIL_OUTBOX_ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY
EMAIL_WORKER_HEALTH_PORT=3001
APP_IMAGE=example/app:replace-with-immutable-tag
WEB_IMAGE=example/web:replace-with-immutable-tag
