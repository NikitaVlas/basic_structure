# syntax=docker/dockerfile:1.7
FROM node:22-alpine AS build
WORKDIR /app
COPY . .
RUN --mount=type=cache,target=/root/.npm npm ci --ignore-scripts
RUN npm run typecheck && npm run build
RUN mkdir -p /out && \
    npx esbuild apps/api/src/server.ts --bundle --platform=node --format=esm --target=node22 --external:pg --external:redis --external:nodemailer --outfile=/out/api.mjs && \
    npx esbuild packages/email/src/worker-cli.ts --bundle --platform=node --format=esm --target=node22 --external:pg --external:redis --external:nodemailer --outfile=/out/worker.mjs && \
    npx esbuild packages/database/src/migrate-cli.ts --bundle --platform=node --format=esm --target=node22 --external:pg --outfile=/out/migrate.mjs
RUN npm prune --omit=dev --ignore-scripts

FROM node:22-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /out ./
COPY --from=build --chown=node:node /app/packages/database/migrations /migrations
USER node
EXPOSE 3000 3001
HEALTHCHECK --interval=15s --timeout=3s --start-period=15s --retries=4 \
  CMD wget -q -O /dev/null http://127.0.0.1:3000/health || exit 1
CMD ["node", "api.mjs"]
