{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/basic-structure/project-config.schema.json",
  "title": "Basic Structure project configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "surfaces", "modules", "adapters", "verification"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "profile"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
        "description": { "type": "string", "minLength": 1 },
        "profile": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
      }
    },
    "surfaces": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    },
    "modules": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    },
    "adapters": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {
        "required": { "type": "boolean" }
      }
    }
  }
}
