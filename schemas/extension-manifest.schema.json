{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/basic-structure/extension-manifest.schema.json",
  "title": "Basic Structure extension manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "id", "name", "description", "files", "requires", "conflicts"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "kind": { "enum": ["profile", "module", "adapter"] },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "files": { "type": "string", "minLength": 1 },
    "requires": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "conflicts": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "contributions": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]*$" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "packageDependencies": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
