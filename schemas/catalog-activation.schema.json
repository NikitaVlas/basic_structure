{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Basic Structure active catalog registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogs"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalogs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["publisher", "id", "version", "digest", "keyId", "fingerprint", "identities", "activatedAt"],
        "properties": {
          "publisher": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "keyId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "identities": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^(profile|module|adapter):[a-z][a-z0-9-]*$" } },
          "activatedAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
