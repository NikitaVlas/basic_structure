{
  "$schema": "../../schemas/extension-manifest.schema.json",
  "schemaVersion": 2,
  "kind": "module",
  "id": "rate-limit-valkey",
  "version": "1.0.0",
  "starter": ">=0.1.0 <1.0.0",
  "name": "Distributed rate limiting",
  "description": "Pluggable memory and Valkey fixed-window rate limiting with HMAC-pseudonymous keys.",
  "files": "template",
  "requires": { "module:observability": "^1.0.0" },
  "conflicts": [],
  "contributions": { "API_ENV": "contributions/api-env.txt" },
  "packageDependencies": {
    "apps/api/package.json": { "dependencies": { "@{{PROJECT_NAME}}/rate-limit": "*" } },
    "package.json": {
      "scripts": {
        "rate-limit:up": "docker compose -f compose.rate-limit.yml up -d --wait",
        "rate-limit:down": "docker compose -f compose.rate-limit.yml down"
      }
    }
  }
}
