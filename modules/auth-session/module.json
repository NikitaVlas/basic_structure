{
  "$schema": "../../schemas/extension-manifest.schema.json",
  "schemaVersion": 2,
  "kind": "module",
  "id": "auth-session",
  "version": "1.0.0",
  "starter": ">=0.1.0 <1.0.0",
  "name": "Secure session authentication",
  "description": "Registration, login, logout, current-user API, opaque cookie sessions, rate limiting, and browser forms.",
  "files": "template",
  "requires": { "module:shared-contracts": "^1.0.0", "module:database-postgres": "^1.0.0", "module:observability": "^1.0.0", "module:transactional-email": "^1.0.0", "module:rate-limit-valkey": "^1.0.0" },
  "conflicts": [],
  "contributions": {
    "API_IMPORTS": "contributions/api-imports.txt",
    "API_REQUEST_HANDLERS": "contributions/api-request-handlers.txt",
    "API_SHUTDOWN": "contributions/api-shutdown.txt",
    "API_ENV": "contributions/api-env.txt",
    "WEBAPP_IMPORTS": "contributions/webapp-imports.txt",
    "WEBAPP_BODY": "contributions/webapp-body.txt"
  },
  "packageDependencies": {
    "apps/api/package.json": {
      "dependencies": { "@{{PROJECT_NAME}}/auth": "*", "@{{PROJECT_NAME}}/email": "*", "@{{PROJECT_NAME}}/rate-limit": "*" }
    },
    "apps/webapp/package.json": {
      "dependencies": { "@{{PROJECT_NAME}}/contracts": "*" }
    }
  }
}
