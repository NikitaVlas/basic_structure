{
  "$schema": "../../schemas/extension-manifest.schema.json",
  "schemaVersion": 2,
  "kind": "module",
  "id": "e2e-playwright",
  "version": "1.0.0",
  "starter": ">=0.1.0 <1.0.0",
  "capabilities": ["e2e-testing","browser-testing"],
  "tags": ["testing","playwright"],
  "maturity": "stable",
  "name": "Playwright browser E2E",
  "description": "Isolated browser journeys across PostgreSQL, Valkey, Mailpit, API, email worker, and React webapp.",
  "files": "template",
  "requires": { "profile:fullstack-web": "^1.0.0", "module:database-postgres": "^1.0.0", "module:transactional-email": "^1.0.0", "module:rate-limit-valkey": "^1.0.0", "module:auth-session": "^1.0.0" },
  "conflicts": [],
  "packageDependencies": {
    "package.json": {
      "scripts": {
        "e2e:stack": "node apps/e2e/support/start-stack.mjs",
        "test:e2e": "npm run e2e --workspace @{{PROJECT_NAME}}/e2e"
      }
    }
  }
}
